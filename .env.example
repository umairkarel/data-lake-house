# ==============================================================================
# Data Lakehouse Configuration Secrets
# Copy this file to '.env' and update the values for your environment.
# ==============================================================================

# ------------------------------------------------------------------------------
# S3 / MinIO Storage Credentials
# ------------------------------------------------------------------------------
# In local development, this points to the docker 'minio' container. 
# For production, change to the AWS S3 endpoint (e.g. s3.amazonaws.com)
S3_ENDPOINT=http://minio:9000

# Your AWS access key or MinIO root user
S3_ACCESS_KEY=minioadmin

# Your AWS secret key or MinIO root password
S3_SECRET_KEY=minioadmin

# S3 Region (MinIO ignores this, but AWS requires it, usually us-east-1)
S3_REGION=us-east-1

# Path Style Access:
# - MinIO / Local S3 mocks: MUST be 'true'
# - Real AWS S3: MUST be 'false'
S3_PATH_STYLE_ACCESS=true
